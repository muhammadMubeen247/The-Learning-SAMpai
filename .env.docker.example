# ── PostgreSQL ────────────────────────────────────────────────────────────────
# SQLAlchemy (relational models) — keep postgresql+psycopg scheme
DATABASE_URL=postgresql+psycopg://postgres:password@db:5432/Learning_SAMpai_db

# asyncpg uses plain postgresql:// scheme (no driver prefix)
ASYNCPG_DATABASE_URL=postgresql://postgres:password@db:5432/Learning_SAMpai_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=Learning_SAMpai_db

# ── Neo4j Knowledge Graph ─────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sampai_neo4j_password
NEO4J_DATABASE=neo4j

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_DATA_DIR=/app/chroma_data

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ENDPOINT=your_r2_endpoint_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=your_bucket_name_here
R2_ACCOUNT_ID=your_account_id_here

# ── Redis (WebSocket real-time) ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
WS_FANOUT=memory

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://backend:8000
NEXT_PUBLIC_CLIENT_API_URL=http://localhost:8000
